# /default.nix
_: {
{% macro render_attrset(data, indentation) %}
{% for key, value in data.items() %}
{{ " " * indentation }}{{ key }} = {% if value is mapping %}
{
{{ render_attrset(value, indentation + 2) }}{{ " " * indentation }}};
{% else %}
{{ "[ ]" if value is sequence and value is not string and (value | length) == 0 else value | to_nix }};
{% endif %}
{% endfor %}
{% endmacro %}
{% for name, data in [
  ("cli", cli), ("desktops", desktops), ("networking", networking),
  ("programs", editors), ("services", services), ("luxnix", luxnix), ("roles", roles)
] %}
{% if data %}
  {{ name }} = {
{{ render_attrset(data, 4) }}  };
{% endif %}
{% endfor %}

  home.stateVersion = {{ stateVersion | nix_string }};
}{{ "\n" }}
