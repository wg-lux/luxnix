# {{ hostname }}/default.nix
{#
  All option paths are merged into one nested attribute tree, sorted by path,
  with `roles`, `services` and `luxnix` first. A branch with several children
  becomes a nested set; a single-child branch stays a dotted path. Each key is
  therefore bound once per attribute set, and an exact duplicate option path
  fails rendering instead of being silently overridden.

  A path nested below another configured path (for example
  `bindMounts."/srv"` below an expression-valued `bindMounts`) cannot share
  that attribute set, so it is rendered into an overlay layer and merged with
  `lib.recursiveUpdate`. Line wrapping is left to the nixfmt pass of the
  Autoconf pipeline.
#}
{% set sections = [("roles.", role_configs), ("services.", service_configs), ("luxnix.", luxnix_configs), ("", nixos_configs)] -%}
{% set layers = sections | nix_attr_layers(("roles", "services", "luxnix")) -%}
{% set usage = namespace(config=false) -%}
{% for _prefix, configs in sections %}{% for value in configs.values() %}{% if "config." in (value | nix) %}{% set usage.config = true %}{% endif %}{% endfor %}{% endfor -%}
{% macro bindings(entries, pad) -%}
{% for entry in entries %}{% if not loop.first and (pad | length == 2 or entry.children or loop.previtem.children) %}
{% endif %}{% if entry.children %}{{ pad }}{{ entry.name }} = {
{{ bindings(entry.children, pad ~ "  ") }}{{ pad }}};
{% elif entry.value is string and '\n' in entry.value %}{{ pad }}{{ entry.name }} = ''
{{ entry.value | trim | indent(pad | length + 2, true) }}
{{ pad }}'';
{% elif entry.value is sequence and entry.value is not string and entry.value %}{{ pad }}{{ entry.name }} = [
{% for item in entry.value %}{{ pad }}  {{ item | nix }}
{% endfor %}{{ pad }}];
{% else %}{{ pad }}{{ entry.name }} = {{ entry.value | nix }};
{% endif %}{% endfor %}
{%- endmacro -%}
{
{% if usage.config %}  config,
{% endif %}  pkgs,
  lib,
  modulesPath,
  ...
}:

{% if layers | length > 1 %}lib.foldl' lib.recursiveUpdate
{% endif %}{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
    ../host-common.nix
    ./boot-decryption-config.nix
    ./disks.nix
{% for import_expr in import_configs %}    {{ import_expr }}
{% endfor %}  ];
{% if layers %}

{{ bindings(layers[0], "  ") }}{% endif %}}
{% if layers | length > 1 %}[
{% for layer in layers[1:] %}  # Paths nested below an option set above; merged with lib.recursiveUpdate.
  {
{{ bindings(layer, "    ") }}  }
{% endfor %}]
{% endif %}
