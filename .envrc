#!/usr/bin/env bash

#https://devenv.sh/integrations/direnv/#manually-managing-updates-to-direnvrc

eval "$(devenv direnvrc)"

# Bootstrap required secretspec dotenv values on first run.
if [ ! -f ".env" ]; then
  cat > .env <<EOF
HOME_DIR=${HOME}
WORKING_DIR=$(pwd -P)
EOF
  echo "direnv: created .env with HOME_DIR and WORKING_DIR defaults"
fi


# https://raw.githubusercontent.com/cachix/devenv/v2.0.6/devenv/direnvrc
# direnv fetchurl "https://raw.githubusercontent.com/cachix/devenv/v2.0.6/devenv/direnvrc"

source_url "https://raw.githubusercontent.com/cachix/devenv/v2.0.6/devenv/direnvrc" "sha256-SedUl6058dnxQASrSeERFCrNESprWThYgZhQ2j4mWss="
use devenv
