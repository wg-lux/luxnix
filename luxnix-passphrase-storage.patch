+    receipt = json.loads(container.with_suffix('.luks.provisioned.json').read_text())
+    assert receipt == {
+        key: record[key] for key in ('machine_id', 'volume', 'luks_uuid')}
+    assert not container.with_suffix('.luks.provisioning.json').exists()
