
# devenv 1.11.x writes the SecretSpec status preamble to stdout before the
# shell program produced by print-dev-env. Keep the status visible on stderr
# so direnv only evaluates the shell program.
_luxnix_devenv_direnv() {
  case " $* " in
    *" print-dev-env "*)
      local output
      output="$(command devenv "$@")" || return
      printf '%s\n' "$output" | awk '
        /^unset shellHook$/ { shell_program = 1 }
        shell_program { print; next }
        { print > "/dev/stderr" }
        END {
          if (!shell_program) {
            print "devenv print-dev-env did not emit the expected shell program" > "/dev/stderr"
            exit 1
          }
        }
      '
      ;;
    *)
      command devenv "$@"
      ;;
  esac
}

eval "$(devenv direnvrc)"
DEVENV_BIN=_luxnix_devenv_direnv
use devenv
unset DEVENV_BIN
unset -f _luxnix_devenv_direnv
