WG_LUX_MCP_PUBLIC_HOST=mcp.example.org
WG_LUX_MCP_HOST=127.0.0.1
WG_LUX_MCP_PORT=8765
WG_LUX_MCP_OAUTH_ENABLED=true
WG_LUX_MCP_OAUTH_ISSUER_URL=https://keycloak.endo-reg.net/realms/master
WG_LUX_MCP_OAUTH_CLIENT_ID=wg-lux-mcp
WG_LUX_MCP_OAUTH_REQUIRED_SCOPES='["openid"]'
WG_LUX_MCP_OAUTH_JWT_ALGORITHMS='["RS256"]'
WG_LUX_MCP_REPO_LX_ANNOTATE=/srv/wg-lux/lx-annotate
WG_LUX_MCP_REPO_ENDOREG_DB=/srv/wg-lux/endoreg-db
WG_LUX_MCP_REPO_LX_DATA_MODELS=/srv/wg-lux/lx-data-models
WG_LUX_FEATURE_PROVIDER_REGISTRY=/etc/wg-lux/features/providers.json
WG_LUX_FEATURE_STATE_ROOT=/var/lib/wg-lux/features
# Optional generic-client gate. Prefer OAuth/OIDC or Secure MCP Tunnel for ChatGPT.
# WG_LUX_MCP_BEARER_TOKEN=replace-with-long-random-secret
