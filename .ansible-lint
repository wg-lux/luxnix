exclude_paths:
    - modules/
    - mkdocs.yaml
    - docs/
    - conf/
    - examples/
    # Non-Ansible YAML: feature-tracker coordination files and release manifests.
    - feature-tracking/
    - release-artifacts/
    # Rewritten by the scripts/python-quality.py ratchet with yaml.safe_dump.
    - python-quality.yml

skip_list:
    - yaml[line-length]
    - role-name # Skip the role name validation rule
