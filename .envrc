#!/usr/bin/env bash
if [ ! -f .env ]; then
  cat << EOF > .env
HOME_DIR=$HOME
WORKING_DIR=$PWD
EOF
fi
# This release mixes SecretSpec diagnostics into shell code consumed by direnv.
case "$(devenv --version)" in
  "devenv 1.11.1"*)
    log_error 'Devenv 1.11.1 produces invalid direnv shell output. Upgrade the Devenv CLI (2.1.2 verified), then run direnv reload. Explicit devenv shell commands remain available.'
    return 1
    ;;
esac
eval "$(devenv direnvrc)"

# You can pass flags to the devenv command
# For example: use devenv --impure --option services.postgres.enable:bool true
use devenv