#!/usr/bin/env bash

#https://devenv.sh/integrations/direnv/#manually-managing-updates-to-direnvrc

eval "$(devenv direnvrc)"

# Bootstrap required secretspec dotenv values on first run.
if [ ! -f ".env" ]; then
  cat > .env <<EOF
HOME_DIR=${HOME}
WORKING_DIR=$(pwd -P)
EOF
  echo "direnv: created .env with HOME_DIR and WORKING_DIR defaults"
fi

# Auto-detect secrets stick (USB) if LX_SECRETS_STICK is not already set.
# Set LX_SECRETS_STICK manually to skip discovery, e.g.:

export LX_SECRETS_STICK=/home/admin/master-vault

